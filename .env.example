# Copy to .env.local and fill in. See SETUP.md.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Supabase → Project Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=

# Mux → Settings → Access Tokens (Mux Video: read + write)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Mux → Settings → Webhooks (deployed environments only)
MUX_WEBHOOK_SECRET=
